@model AppointmentBooking.ViewModels.MedicalRecords_ViewModel

@{
    bool isDoctor = Session["Role"] != null &&
                    Session["Role"].ToString() == "Doctor";
}

<div class="prescription-container">

    <input type="hidden"
           id="prescriptionAppointmentId"
           value="@Model.AppointmentId" />


    <!-- =====================================================
         APPOINTMENT SUMMARY
         ===================================================== -->

    <div class="prescription-info">

        <div class="prescription-info-item patient-info">
            <label>Patient</label>

            <input type="text"
                   class="form-control"
                   value="@Model.PatientName"
                   readonly />
        </div>

        <div class="prescription-info-item">
            <label>Date</label>

            <input type="text"
                   class="form-control"
                   value="@Model.AppointmentDate.ToString("dd-MM-yyyy")"
                   readonly />
        </div>

        <div class="prescription-info-item">
            <label>Time</label>

            <input type="text"
                   class="form-control"
                   value="@Model.Time"
                   readonly />
        </div>

    </div>


    <div class="prescription-divider"></div>


    <!-- =====================================================
         DIAGNOSIS
         ===================================================== -->

    <div class="prescription-field">

        <div class="prescription-field-label">
            <span class="field-icon">+</span>
            <span>Diagnosis</span>
        </div>

        <div class="prescription-field-control">

            @if (isDoctor)
            {
                <textarea id="diagnosis"
                          class="form-control"
                          rows="3"
                          placeholder="Enter diagnosis">@Model.Diagnosis</textarea>
            }
            else
            {
                <div class="medical-record-value">
                    @Model.Diagnosis
                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         DOCTOR NOTES
         ===================================================== -->

    <div class="prescription-field">

        <div class="prescription-field-label">
            <span class="field-icon">≡</span>
            <span>Doctor Notes</span>
        </div>

        <div class="prescription-field-control">

            @if (isDoctor)
            {
                <textarea id="doctorNotes"
                          class="form-control"
                          rows="4"
                          placeholder="Enter consultation notes">@Model.DoctorNotes</textarea>
            }
            else
            {
                <div class="medical-record-value medical-record-large">
                    @Model.DoctorNotes
                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         MEDICINES
         ===================================================== -->

    <div class="prescription-field medicines-field">

        <div class="prescription-field-label">
            <span class="field-icon">Rx</span>
            <span>Medicines / Prescription</span>
        </div>

        <div class="prescription-field-control">

            @if (isDoctor)
            {
                <textarea id="medicines"
                          class="form-control"
                          rows="5"
                          placeholder="Enter medicines, dosage, frequency and duration">@Model.Medicines</textarea>

                <small class="prescription-hint">
                    Example: Paracetamol 500mg - 1-0-1 - 3 days
                </small>
            }
            else
            {
                <div class="medical-record-value medical-record-prescription">
                    @Model.Medicines
                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         PROCEDURES
         ===================================================== -->

    <div class="prescription-field">

        <div class="prescription-field-label">
            <span class="field-icon">↗</span>
            <span>Further Procedure</span>
        </div>

        <div class="prescription-field-control">

            @if (isDoctor)
            {
                <textarea id="procedures"
                          class="form-control"
                          rows="3"
                          placeholder="Enter further procedure or treatment">@Model.Procedures</textarea>
            }
            else
            {
                <div class="medical-record-value">
                    @Model.Procedures
                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         ADVICE
         ===================================================== -->

    <div class="prescription-field">

        <div class="prescription-field-label">
            <span class="field-icon">i</span>
            <span>Advice</span>
        </div>

        <div class="prescription-field-control">

            @if (isDoctor)
            {
                <textarea id="advice"
                          class="form-control"
                          rows="3"
                          placeholder="Enter advice for patient">@Model.Advice</textarea>
            }
            else
            {
                <div class="medical-record-value">
                    @Model.Advice
                </div>
            }

        </div>
        
    </div>


    <!-- =====================================================
         ACTION
         ===================================================== -->

    @if (isDoctor)
    {
        <div class="prescription-actions">

            <button type="button"
                    class="btn btn-success"
                    id="btnCompleteAppointment">

                <span class="complete-icon">✓</span>
                Complete Appointment

            </button>

        </div>
    }

</div>