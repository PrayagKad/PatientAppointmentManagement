@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h2>Admin Dashboard</h2>
        <h3>@TempData["msg"]</h3>

        <p class="text-muted">
            Welcome, @Session["FullName"]
        </p>
    </div>


    <!-- Management Cards -->
    <div class="row g-4">

        <!-- Manage Doctors -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Manage Doctors
                    </h4>

                    <p class="card-text text-muted">
                        View, add, edit and delete doctors.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnManageDoctors">
                        Manage Doctors
                    </button>

                </div>

            </div>

        </div>


        <!-- Manage Admins -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Manage Admins
                    </h4>

                    <p class="card-text text-muted">
                        View, add, edit and delete administrators.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnManageAdmins">
                        Manage Admins
                    </button>

                </div>

            </div>

        </div>


        <!-- Manage Patients -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Manage Patients
                    </h4>

                    <p class="card-text text-muted">
                        View and manage registered patients.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnManagePatients">
                        Manage Patients
                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Manage Doctors Modal -->
    <!-- ============================= -->

    <div class="modal fade"
         id="doctorModal"
         tabindex="-1"
         aria-labelledby="doctorModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="doctorModalLabel">
                        Manage Doctors
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="d-flex justify-content-between mb-3">

                        <h5>Doctors</h5>

                        <button type="button"
                                class="btn btn-success"
                                id="btnAddDoctor">
                            + Add Doctor
                        </button>

                    </div>


                    <div id="doctorLoading"
                         class="text-center">
                        Loading doctors...
                    </div>


                    <div class="table-responsive">

                        <table class="table table-bordered table-hover"
                               id="doctorTable"
                               style="display:none;">

                            <thead>
                                <tr>
                                    <th>Doctor ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Specialization</th>
                                    <th>Qualification</th>
                                    <th>Experience</th>
                                    <th>Fee</th>
                                    <th>Clinic Address</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="doctorTableBody">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Manage Admins Modal -->
    <!-- ============================= -->

    <div class="modal fade"
         id="adminModal"
         tabindex="-1"
         aria-labelledby="adminModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="adminModalLabel">
                        Manage Admins
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="d-flex justify-content-between mb-3">

                        <h5>Administrators</h5>

                        <button type="button"
                                class="btn btn-success"
                                id="btnAddAdmin">
                            + Add Admin
                        </button>

                    </div>


                    <div id="adminLoading"
                         class="text-center">
                        Loading admins...
                    </div>


                    <div class="table-responsive">

                        <table class="table table-bordered table-hover"
                               id="adminTable"
                               style="display:none;">

                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="adminTableBody">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Manage Patients Modal -->
    <!-- ============================= -->

    <div class="modal fade"
         id="patientModal"
         tabindex="-1"
         aria-labelledby="patientModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="patientModalLabel">
                        Manage Patients
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="patientLoading"
                         class="text-center">
                        Loading patients...
                    </div>


                    <div class="table-responsive">

                        <table class="table table-bordered table-hover"
                               id="patientTable"
                               style="display:none;">

                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="patientTableBody">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function () {

            // ----------------------------
            // Manage Doctors
            // ----------------------------

            $("#btnManageDoctors").click(function () {

                $("#doctorModal").modal("show");

                loadDoctors();

            });


            // ----------------------------
            // Manage Admins
            // ----------------------------

            $("#btnManageAdmins").click(function () {

                $("#adminModal").modal("show");

                loadAdmins();

            });


            // -------------------
            // Manage Patients
            // ----------

            $("#btnManagePatients").click(function () {

                $("#patientModal").modal("show");

                loadPatients();

            });


            // -----------
            // Add Doctor
            // ------------------

            $("#btnAddDoctor").click(function () {

                // opens seperate page
                window.location.href =
                    '@Url.Action("AddDoctor", "Admin")';

            });


            // ----------------------------
            // Add Admin
            // -----------------

            $("#btnAddAdmin").click(function () {

                window.location.href =
                    '@Url.Action("AddAdmin", "Admin")';

            });

        });


        // ==============
        // Load Doctors
        // =====================

        function loadDoctors() {

            $("#doctorLoading").show();

            $("#doctorTable").hide();

            $.ajax({

                url: '@Url.Action("GetDoctors", "Admin")',

                type: 'GET',

                success: function (response) {

                    var tbody =
                        $("#doctorTableBody");

                    tbody.empty();


                    $.each(response, function (index, doctor) {

                        var row = `
                            <tr>

                                <td>${doctor.DoctorId}</td>

                                <td>${doctor.FullName}</td>

                                <td>${doctor.Email}</td>

                                <td>${doctor.Phone || ''}</td>

                                <td>${doctor.Specialization}</td>

                                <td>${doctor.Qualification || ''}</td>

                                <td>${doctor.ExperienceYears || ''}</td>

                                <td>${doctor.ConsultationFee || ''}</td>

                                <td>${doctor.ClinicAddress || ''}</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            onclick="editDoctor(${doctor.DoctorId})">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="deleteDoctor(${doctor.DoctorId})">
                                        Delete
                                    </button>
                                </td>

                            </tr>
                        `;

                        tbody.append(row);

                    });


                    $("#doctorLoading").hide();

                    $("#doctorTable").show();

                },

                error: function () {

                    $("#doctorLoading")
                        .text("Unable to load doctors.");

                }

            });

        }


        // ============================
        // Load Admins
        // ============================

        function loadAdmins() {

            $("#adminLoading").show();

            $("#adminTable").hide();

            $.ajax({

                url: '@Url.Action("GetAdmins", "Admin")',

                type: 'GET',

                success: function (response) {

                    var tbody =
                        $("#adminTableBody");

                    tbody.empty();


                    $.each(response, function (index, admin) {

                        var row = `
                            <tr>

                                <td>${admin.UserId}</td>

                                <td>${admin.FullName}</td>

                                <td>${admin.Email}</td>

                                <td>${admin.Phone || ''}</td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            onclick="editAdmin(${admin.UserId})">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="deleteAdmin(${admin.UserId})">
                                        Delete
                                    </button>

                                </td>

                            </tr>
                        `;

                        tbody.append(row);

                    });


                    $("#adminLoading").hide();

                    $("#adminTable").show();

                },

                error: function () {

                    $("#adminLoading")
                        .text("Unable to load admins.");

                }

            });

        }


        // ============================
        // Load Patients
        // ============================

        function loadPatients() {

            $("#patientLoading").show();

            $("#patientTable").hide();

            $.ajax({

                url: '@Url.Action("GetPatients", "Admin")',

                type: 'GET',

                success: function (response) {

                    var tbody =
                        $("#patientTableBody");

                    tbody.empty();


                    $.each(response, function (index, patient) {

                        var row = `
                            <tr>

                                <td>${patient.PatientId}</td>

                                <td>${patient.FullName}</td>

                                <td>${patient.Email}</td>

                                <td>${patient.Phone || ''}</td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            onclick="editPatient(${patient.PatientId})">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="deletePatient(${patient.PatientId})">
                                        Delete
                                    </button>

                                </td>

                            </tr>
                        `;

                        tbody.append(row);

                    });


                    $("#patientLoading").hide();

                    $("#patientTable").show();

                },

                error: function () {

                    $("#patientLoading")
                        .text("Unable to load patients.");

                }

            });

        }


        // ============================
        // Doctor Actions
        // ============================

        function editDoctor(doctorId) {

            window.location.href =
                '@Url.Action("EditDoctor", "Admin")'
                + '?doctorId=' + doctorId;

        }


        function deleteDoctor(doctorId) {

            if (!confirm("Are you sure you want to delete this doctor?"))
                return;

            // implement the AJAX delete later.

        }


        // ============================
        // Admin Actions
        // ============================

        function editAdmin(userId) {

            window.location.href =
                '@Url.Action("EditAdmin", "Admin")'
                + '?userId=' + userId;

        }


        function deleteAdmin(userId) {

            if (!confirm("Are you sure you want to delete this admin?"))
                return;

            //implement the AJAX delete later.

        }


        // ============================
        // Patient Actions
        // ============================

        function editPatient(patientId) {

            window.location.href =
                '@Url.Action("EditPatient", "Admin")'
                + '?patientId=' + patientId;

        }


        function deletePatient(patientId) {

            if (!confirm("Are you sure you want to delete this patient?"))
                return;

         //  implement the AJAX delete later

        }

    </script>
}