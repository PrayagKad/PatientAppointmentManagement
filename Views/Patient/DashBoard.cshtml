@{
    ViewBag.Title = "Patient Dashboard";
}

<div class="container" style="margin-top:30px;">

    <!-- Header -->
    <div class="row">
        <div class="col-md-8">
            <h2>Patient Dashboard</h2>
            <p>
                Welcome, @Session["FullName"]
            </p>
        </div>

        <div class="col-md-4 text-right">
            <button type="button"
                    class="btn btn-primary"
                    id="btnMyAppointments">
                My Appointments
            </button>
        </div>
    </div>

    <hr />

    <!-- Doctors -->
    <div class="panel panel-default">

        <div class="panel-heading">
            <h4>Available Doctors</h4>
        </div>

        <div class="panel-body">

            <div class="row" id="doctorContainer">

                <div class="col-md-12 text-center">
                    Loading doctors...
                </div>

            </div>

        </div>

    </div>

    <!-- Doctor Booking Modal -->
    <div class="modal fade" id="doctorModal" tabindex="-1" role="dialog">

        <div class="modal-dialog" role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <button type="button"
                            class="close"
                            data-dismiss="modal">
                        <span>&times;</span>
                    </button>

                    <h4 class="modal-title" id="doctorName">
                    </h4>

                </div>

                <div class="modal-body">

                    <!-- Doctor Information -->
                    <div id="doctorInfo">

                        <p>
                            <strong>Specialization:</strong>
                            <span id="doctorSpecialization"></span>

                        </p>

                        <p>
                            <strong>Qualification:</strong>
                            <span id="doctorQualification"></span>
                        </p>

                        <p>
                            <strong>Experience:</strong>
                            <span id="doctorExperience"></span>
                        </p>

                    </div>

                    <hr />

                    <!-- Available Dates -->
                    <div class="form-group">

                        <label for="appointmentDate">
                            Appointment Date
                        </label>

                        <select id="appointmentDate"
                                class="form-control">

                            <option value="">
                                Select Available Date
                            </option>

                        </select>

                    </div>

                    <!-- Available Slots -->
                    <div class="form-group">

                        <label for="appointmentSlot">
                            Available Slots
                        </label>

                        <select id="appointmentSlot"
                                class="form-control">

                            <option value="">
                                Select Date First
                            </option>

                        </select>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-default"
                            data-dismiss="modal">
                        Close
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnBookAppointment">
                        Book Appointment
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Patients details modal -->
    <div class="modal fade" id="patientDetailsModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">
                        &times;
                    </button>
                    <h4 class="modal-title">Patient Details</h4>
                </div>

                <div class="modal-body">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text"
                               id="patientFullName"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="text"
                               id="patientEmail"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text"
                               id="patientPhone"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <input type="date"
                               id="patientDateOfBirth"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <select id="patientGender" class="form-control">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea id="patientAddress"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-default"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnPatientDetailsContinue">
                        Continue
                    </button>

                </div>

            </div>
        </div>
    </div>


    <!-- boooking summary modal-->
    <div class="modal fade" id="bookingSummaryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">
                        &times;
                    </button>
                    <h4 class="modal-title">Confirm Appointment</h4>
                </div>

                <div class="modal-body">

                    <p>
                        <strong>Doctor:</strong>
                        <span id="summaryDoctor"></span>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <span id="summaryDate"></span>
                    </p>

                    <p>
                        <strong>Time:</strong>
                        <span id="summaryTime"></span>
                    </p>

                    <hr />

                    <p>Are you sure you want to book this appointment?</p>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-default"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnConfirmBooking">
                        Confirm Booking
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!--my appointments modal -->
    <div class="modal fade" id="myAppointmentsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <button type="button"
                            class="close"
                            data-dismiss="modal">
                        &times;
                    </button>

                    <h4 class="modal-title">My Appointments</h4>
                </div>

                <div class="modal-body">

                    <div id="appointmentsLoading">
                        Loading appointments...
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped"
                               id="appointmentsTable"
                               style="display:none;">


                            <!-- thead ??-->
                            <thead>
                                <tr>
                                    <th>Doctor</th>
                                    <th>Specialization</th>
                                    <th>Date</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody id="appointmentsBody">
                            </tbody>

                        </table>
                    </div>

                    <div id="noAppointments"
                         class="alert alert-info"
                         style="display:none;">
                        You don't have any appointments.
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>



<script src="~/Scripts/jquery-3.4.1.min.js"></script>

<script>

    var selectedDoctorId = 0;

    $(document).ready(function () {

        loadDoctors();
    });


    function loadDoctors() {

        $.ajax({

            url: '@Url.Action("GetAllDoctors", "Patient")',

            type: 'GET',

            success: function (response) {

                var doctors = JSON.parse(response);

                var container = $("#doctorContainer");

                container.empty();


                if (doctors.length === 0) {

                    container.append(
                        '<div class="col-md-12 text-center">' +
                            '<p>No doctors available.</p>' +
                        '</div>'
                    );

                    return;
                }


                $.each(doctors, function (index, doctor) {

                    console.log(doctor);

                    var card =
                        '<div class="col-md-4" style="margin-bottom:20px;">' +

                            '<div class="panel panel-info">' +

                                '<div class="panel-heading">' +
                                    '<h4>Dr. ' + doctor.FullName + '</h4>' +
                                '</div>' +

                                '<div class="panel-body">' +

                                    '<p>' +
                                            '<strong>Specialization:</strong> ' +
                                            '<span class="doctor-specialization">' +
                                            doctor.Specialization +
                                             '</span>' +
                                    '</p>' +

                                    '<p>' +
                                            '<strong>Qualification:</strong> ' +
                                            '<span class="doctor-qualification">' +
                                            doctor.Qualification +
                                            '</span>' +
                                    '</p>' +

                                    '<p>' +
                                            '<strong>Experience:</strong> ' +
                                            '<span class="doctor-experience">' +
                                            doctor.Experienceyears +
                                            '</span> Years' +
                                    '</p>' +

                                    '<button type="button" ' +
                                            'class="btn btn-primary btnViewDoctor" ' +
                                            'data-doctorid="' + doctor.DoctorId + '">' +
                                        'View Doctor' +
                                    '</button>' +

                                '</div>' +

                            '</div>' +

                        '</div>';

                    container.append(card);

                });

            },

            error: function () {

                $("#doctorContainer").html(

                    '<div class="col-md-12 text-center">' +
                        '<p class="text-danger">' +
                            'Unable to load doctors.' +
                        '</p>' +
                    '</div>'

                );

            }

        });

    }

    $(document).on("click", ".btnViewDoctor", function () {

        selectedDoctorId = $(this).data("doctorid");

        var panel = $(this).closest(".panel");

        var doctorName = panel
            .find(".panel-heading h4")
            .text();

        var specialization = panel
            .find(".doctor-specialization")
            .text();

        var qualification = panel
            .find(".doctor-qualification")
            .text();

        var experience = panel
            .find(".doctor-experience")
            .text();

        $("#doctorName").text(doctorName);
        $("#doctorSpecialization").text(specialization);
        $("#doctorQualification").text(qualification);
        $("#doctorExperience").text(experience);

        $("#appointmentDate").html(
            '<option value="">Loading dates...</option>'
        );

        $("#appointmentSlot").html(
            '<option value="">Select Date First</option>'
        );

        $("#doctorModal").modal("show");

        loadAvailableDates(selectedDoctorId);
    });

    function loadAvailableDates(doctorId) {

         $.ajax({

            url: '@Url.Action("GetDoctorAvailableDates", "Patient")',

            type: 'GET',

            data: {
                doctorId: doctorId
            },

            success: function (response) {

                var dates = JSON.parse(response);

                var dropdown = $("#appointmentDate");

                dropdown.empty();

                dropdown.append(
                    '<option value="">Select Available Date</option>'
                );

                if (dates.length === 0) {

                    dropdown.append(
                        '<option value="">No available dates</option>'
                    );

                    return;
                }

                $.each(dates, function (index, item) {

                    dropdown.append(
                        '<option value="' +
                        item.ScheduleDate +
                        '">' +
                        item.ScheduleDate +
                        '</option>'
                    );

                });



            },

            error: function (xhr) {

                console.log(xhr.responseText);

                $("#appointmentDate").html(
                    '<option value="">Unable to load dates</option>'
                );

            }

        });

    }

    $("#appointmentDate").change(function () {

        var selectedDate = $(this).val();

        var slotDropdown = $("#appointmentSlot");

        slotDropdown.empty();

        if (selectedDate === "") {

            slotDropdown.append(
                '<option value="">Select Date First</option>'
            );

            return;
        }

        slotDropdown.append(
            '<option value="">Loading slots...</option>'
        );

        $.ajax({

            url: '@Url.Action("GetDoctorAvailableSlots", "Patient")',

            type: 'GET',

            data: {
                doctorId: selectedDoctorId,
                selectedDate: selectedDate
            },

            success: function (response) {

                var slots = JSON.parse(response);

                slotDropdown.empty();

                if (slots.length === 0) {

                    slotDropdown.append(
                        '<option value="">No available slots</option>'
                    );

                    return;
                }

                slotDropdown.append(
                    '<option value="">Select Slot</option>'
                );

                $.each(slots, function (index, slot) {

                    slotDropdown.append(
                        '<option value="' + slot.SlotId + '">' +
                        slot.StartTime + ' - ' +
                        slot.EndTime +
                        '</option>'
                    );

                });

            },

            error: function (xhr)
            {

                console.log(xhr.status);
                console.log(xhr.responseText);

                slotDropdown.empty();

                slotDropdown.append('<option value="">Unable to load slots</option>');

            }

        });

    });


    // first book oppintment in doctor details popup

    $("#btnBookAppointment").click(function () {

    var selectedDate = $("#appointmentDate").val();
    var selectedSlotId = $("#appointmentSlot").val();

    // Check date
    if (selectedDate === "") {
        alert("Please select an appointment date.");
        return;
    }

    // Check slot
    if (selectedSlotId === "") {
        alert("Please select an appointment slot.");
        return;
        }


        //When the user clicks Book Appointment, populate the summary:

        var doctorName = $("#doctorName").text();
        var selectedSlotText = $("#appointmentSlot option:selected").text();


        // id is summary modal
        $("#summaryDoctor").text(doctorName);
        $("#summaryDate").text(selectedDate);
        $("#summaryTime").text(selectedSlotText);


        // open patient details modal
            $("#patientDetailsModal").modal("show");

    // Check login
    $.ajax({

        url: '@Url.Action("IsLoggedIn", "Account")',

        type: 'GET',

        success: function (response) {

            if (!response.isLoggedIn) {

            // Save booking information (not yet implemeted)
            sessionStorage.setItem("bookingDoctorId", selectedDoctorId );

            sessionStorage.setItem(  "bookingDate", selectedDate );

            sessionStorage.setItem( "bookingSlotId",  selectedSlotId );

            // Go to login
                window.location.href = '@Url.Action("Login", "Account")';

                return;
            }

            // Only logged-in patient reaches here
            $("#patientDetailsModal").modal("show");

            // load patient details
            loadPatientDetails();

        },

        error: function () {

            alert("Unable to check login status.");

        }

    });

});

    function loadPatientDetails() {

    $.ajax({
        url: '@Url.Action("GetPatientDetails", "Patient")',
        type: 'GET',

        success: function (response) {

            var patient = JSON.parse(response);

            if (patient.length === 0) {
                alert("Patient details not found.");
                return;
            }

            var data = patient[0];

            $("#patientFullName").val(data.FullName);
            $("#patientEmail").val(data.Email);
            $("#patientPhone").val(data.Phone);
            $("#patientDateOfBirth").val(data.DateOfBirth);
            $("#patientGender").val(data.Gender);
            $("#patientAddress").val(data.Address);
        },

        error: function () {
            alert("Unable to load patient details.");
        }
    });
}


    // wt will happpen when continue of patient details modal is clicked
    $("#btnPatientDetailsContinue").click(function () {

        var phone = $("#patientPhone").val();
        var dateOfBirth = $("#patientDateOfBirth").val();
        var gender = $("#patientGender").val();
        var address = $("#patientAddress").val();

        if (phone === "") {
            alert("Please enter phone number.");
            return;
        }

        if (dateOfBirth === "") {
            alert("Please enter date of birth.");
            return;
        }

        if (gender === "") {
            alert("Please select gender.");
            return;
        }

        if (address === "") {
            alert("Please enter address.");
            return;
        }

        // Put patient details into summary
        $("#summaryPhone").text(phone);
        $("#summaryDateOfBirth").text(dateOfBirth);
        $("#summaryGender").text(gender);
        $("#summaryAddress").text(address);

        $("#patientDetailsModal").modal("hide");
        $("#bookingSummaryModal").modal("show");
    });


    //
    $("#btnConfirmBooking").click(function () {

    var slotId = $("#appointmentSlot").val();

    var phone = $("#patientPhone").val();
    var dateOfBirth = $("#patientDateOfBirth").val();
    var gender = $("#patientGender").val();
    var address = $("#patientAddress").val();

    $.ajax({
        url: '@Url.Action("ConfirmBooking", "Patient")',
        type: 'POST',
        data: {
            slotId: slotId,
            phone: phone,
            dateOfBirth: dateOfBirth,
            gender: gender,
            address: address
        },

        success: function (response) {

            if (response.success) {

                alert("Appointment booked successfully.");

                $("#bookingSummaryModal").modal("hide");
                $("#doctorModal").modal("hide");

            } else {

                alert(response.message);
            }
        },

        error: function () {
            alert("Unable to book appointment.");
        }
    });
});

    // get appointment deatils eg scheduled or completed appointments
    $("#btnMyAppointments").click(function () {

    $("#myAppointmentsModal").modal("show");

    loadPatientAppointments();
});

     
 function loadPatientAppointments() {

    $("#appointmentsLoading").show();
    $("#appointmentsTable").hide();
    $("#noAppointments").hide();
    $("#appointmentsBody").empty();

    $.ajax({
        url: '@Url.Action("GetPatientAppointments", "Patient")',
        type: 'GET',

        success: function (response) {

            $("#appointmentsLoading").hide();

            var appointments = JSON.parse(response);

            if (appointments.length === 0) {

                $("#noAppointments").show();
                return;
            }

            $.each(appointments, function (index, appointment) {

                var row = "<tr>" +
                    "<td>" + appointment.DoctorName + "</td>" +
                    "<td>" + appointment.Specialization + "</td>" +
                    "<td>" + appointment.AppointmentDate + "</td>" +
                    "<td>" + appointment.StartTime + "</td>" +
                    "<td>" + appointment.EndTime + "</td>" +
                    "<td>" + appointment.Status + "</td>" +
                    "</tr>";

                $("#appointmentsBody").append(row);
            });

            $("#appointmentsTable").show();
        },

        error: function () {

            $("#appointmentsLoading").hide();

            alert("Unable to load appointments.");
        }
    });
}
</script>