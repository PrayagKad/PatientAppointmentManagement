@{
    ViewBag.Title = "Home Page";
}

<div class="hero">
    <h1>Book a doctor appointment in minutes</h1>
    <p>Find the right specialist, pick an available slot, and keep track of your visits and prescriptions in one place.</p>
    <p class="mb-0">
        @Html.ActionLink("Book an Appointment", "Login", "Account", null, new { @class = "btn btn-primary btn-lg" })
        @Html.ActionLink("Create Account", "RegisterPatient", "Account", null, new { @class = "btn btn-default btn-lg" })
    </p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="feature-card">
            <span class="icon-tile"><span class="glyphicon glyphicon-search"></span></span>
            <h4>Find a doctor</h4>
            <p>Browse doctors by specialization, qualification and experience.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <span class="icon-tile success"><span class="glyphicon glyphicon-calendar"></span></span>
            <h4>Pick a slot</h4>
            <p>See each doctor's available dates and time slots and book instantly.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <span class="icon-tile warning"><span class="glyphicon glyphicon-file"></span></span>
            <h4>Track your care</h4>
            <p>View your upcoming and completed appointments in one place.</p>
        </div>
    </div>
</div>
