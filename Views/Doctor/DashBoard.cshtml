@{
    ViewBag.Title = "Doctor Dashboard";
}

<div class="container">

    <link rel="stylesheet" href="~/Content/doctor.css" />

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Doctor Dashboard</h2>

            <p class="text-muted">
                Welcome, Dr. @Session["FullName"]
            </p>
        </div>

        <div>

            <!-- ADD  Schedule -->
            <button type="button"
                    class="btn btn-primary me-2"
                    id="btnAddSchedule">
                Add Schedule
            </button>

            @Html.ActionLink(
                "Manage Profile",
                "Profile",
                "Doctor",
                null,
                new { @class = "btn btn-secondary" }
            )

        </div>

    </div>


    <div class="row">

        <!-- Today's Appointments -->
        <div class="col-md-6">
            <div class="panel panel-default">

                <div class="panel-heading">
                    <h4> Appointments</h4>
                </div>

                <div class="panel-body">

                    <table id="doctorAppointmentGrid"></table>

                    <div id="doctorAppointmentPager"></div>

                </div>
            </div>
        </div>


        <!-- Schedule Calendar -->
        <div class="col-md-6">
            <div class="panel panel-default">

                <div class="panel-heading">
                    <h4>My Schedule</h4>
                </div>

                <div class="panel-body">

                    <div id="doctorCalendar"></div>

                </div>
            </div>
        </div>

    </div>

</div>

<div class="modal fade"
     id="appointmentModal"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog modal-lg" role="document">

        <div class="modal-content">

            <div class="modal-header">

                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    &times;
                </button>

                <h4 class="modal-title">
                    Manage Appointment
                </h4>

            </div>

            <div class="modal-body"
                 id="prescriptionContainer">

                <!-- Prescription partial will be loaded here -->

            </div>

        </div>

    </div>

</div>


<!-- ================================= -->
<!-- Manage Schedule Modal -->
<!-- ================================= -->

<div class="modal fade"
     id="scheduleModal"
     tabindex="-1"
     aria-labelledby="scheduleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="scheduleModalLabel">
                    Create Schedule
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- Body -->
            <div class="modal-body">

                <form id="scheduleForm">

                    <!-- Schedule Date -->
                    <div class="mb-3">

                        <label class="form-label">
                            Schedule From
                        </label>

                        <input type="date"
                               id="scheduleFrom"
                               class="form-control"
                               required />

                        <div class="text-danger"
                             id="scheduleFromError">
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Schedule To
                        </label>

                        <input type="date"
                               id="scheduleTo"
                               class="form-control"
                               required />

                        <div class="text-danger"
                             id="scheduleToError">
                        </div>

                    </div>


                    <!-- select days of week to create schedule -->
                    <div class="mb-3">

                        <label class="form-label">
                            Apply Schedule On
                        </label>

                        <div class="row">

                            <div class="col-md-6">

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Monday"
                                           id="monday">

                                    <label class="form-check-label"
                                           for="monday">
                                        Monday
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Tuesday"
                                           id="tuesday">

                                    <label class="form-check-label"
                                           for="tuesday">
                                        Tuesday
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Wednesday"
                                           id="wednesday">

                                    <label class="form-check-label"
                                           for="wednesday">
                                        Wednesday
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Thursday"
                                           id="thursday">

                                    <label class="form-check-label"
                                           for="thursday">
                                        Thursday
                                    </label>
                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Friday"
                                           id="friday">

                                    <label class="form-check-label"
                                           for="friday">
                                        Friday
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Saturday"
                                           id="saturday">

                                    <label class="form-check-label"
                                           for="saturday">
                                        Saturday
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input day-check"
                                           type="checkbox"
                                           value="Sunday"
                                           id="sunday">

                                    <label class="form-check-label"
                                           for="sunday">
                                        Sunday
                                    </label>
                                </div>

                            </div>

                        </div>

                        <div class="text-danger"
                             id="dayError">
                        </div>

                    </div>


                    <!-- Start / End -->
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label for="startTime"
                                   class="form-label">
                                Start Time
                            </label>

                            <input type="time"
                                   id="startTime"
                                   class="form-control"
                                   required />

                            <div class="text-danger"
                                 id="startTimeError">
                            </div>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label for="endTime"
                                   class="form-label">
                                End Time
                            </label>

                            <input type="time"
                                   id="endTime"
                                   class="form-control"
                                   required />

                            <div class="text-danger"
                                 id="endTimeError">
                            </div>

                        </div>

                    </div>


                    <!-- Slot Duration -->
                    <div class="mb-3">

                        <label for="slotDuration"
                               class="form-label">
                            Slot Duration
                        </label>

                        <select id="slotDuration"
                                class="form-control"
                                required>

                            <option value="">
                                Select slot duration
                            </option>

                            <option value="15">
                                15 Minutes
                            </option>

                            <option value="30">
                                30 Minutes
                            </option>

                            <option value="45">
                                45 Minutes
                            </option>

                            <option value="60">
                                60 Minutes
                            </option>

                        </select>

                        <div class="text-danger"
                             id="slotDurationError">
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Breaks</label>

                        <div id="breakContainer">

                            <div class="row mb-2 break-row">

                                <div class="col-md-4">
                                    <input type="time"
                                           class="form-control break-start"
                                           placeholder="Start Time">
                                </div>

                                <div class="col-md-3">
                                    <input type="time"
                                           class="form-control break-end"
                                           placeholder="End Time">
                                </div>

                                <div class="col-md-3">
                                    <input type="text"
                                           class="form-control break-reason"
                                           placeholder="Reason">
                                </div>

                                <div class="col-md-2">
                                    <button type="button"
                                            class="btn btn-danger btnRemoveBreak">
                                        Remove
                                    </button>
                                </div>

                            </div>

                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                id="btnAddBreak">
                            + Add Break
                        </button>

                    </div>


                    <!-- General Error -->
                    <div id="scheduleError"
                         class="text-danger mb-2">
                    </div>

                </form>

            </div>


            <!-- Footer -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        id="Cancelbtn">

                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnCreateSchedule">
                    Create Schedule
                </button>

            </div>

        </div>

    </div>

</div>

<style>
    .scheduled-date {
        background-color: #5cb85c !important;
        border-color: #4cae4c !important;
    }
</style>



@section Scripts
{
    
    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/css/ui.jqgrid.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/js/jquery.jqgrid.min.js"></script>

    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/fullcalendar@3.10.2/dist/fullcalendar.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@3.10.2/dist/fullcalendar.min.js"></script>


    <script>

        $(document).ready(function () {

            // Load today's appointments
            loadDoctorAppointments();

            loadDoctorCalendar();



            // Open schedule modal
            $("#btnAddSchedule").click(function () {

                clearScheduleErrors();

                $("#scheduleModal").modal("show");

            });


            // Create schedule
            $("#btnCreateSchedule").click(function () {

                if (!validateSchedule())
                    return;

                createSchedule();

            });

            $("#Cancelbtn").click(function () {

                $("#scheduleModal").modal("hide");

            });

            $("#btnAddBreak").click(function () {

                var row = $(".break-row:first").clone();

                row.find("input").val("");

                $("#breakContainer").append(row);

            });

        });



        // remove break
        $(document).on("click", ".btnRemoveBreak", function () {

            if ($(".break-row").length > 1) {

                $(this)
                    .closest(".break-row")
                    .remove();

            }

        });


        // =--------------------------------------
        // Validate Schedule
        // -------------------------
        function validateSchedule() {

            clearScheduleErrors();

            var from = $("#scheduleFrom").val();
            var to = $("#scheduleTo").val();

            var start = $("#startTime").val();
            var end = $("#endTime").val();

            var duration = $("#slotDuration").val();

            var valid = true;


            if (from === "") {

                $("#scheduleFromError")
                    .text("Please select start date.");

                valid = false;
            }


            if (to === "") {

                $("#scheduleToError")
                    .text("Please select end date.");

                valid = false;
            }


            if (from !== "" && to !== "") {

                if (from > to) {

                    $("#scheduleToError")
                        .text("End date must be after start date.");

                    valid = false;
                }
            }


            if ($(".day-check:checked").length === 0) {

                $("#dayError")
                    .text("Please select at least one day.");

                valid = false;
            }


            if (start === "") {

                $("#startTimeError")
                    .text("Please select start time.");

                valid = false;
            }


            if (end === "") {

                $("#endTimeError")
                    .text("Please select end time.");

                valid = false;
            }


            if (duration === "") {

                $("#slotDurationError")
                    .text("Please select slot duration.");

                valid = false;
            }


            if (start !== "" && end !== "") {

                if (start >= end) {

                    $("#endTimeError")
                        .text("End time must be after start time.");

                    valid = false;
                }
            }


            return valid;
        }


        // =====================
        // Create Schedule
        // ==========
        function createSchedule() {

            var breaks = [];

            $(".break-row").each(function () {

                var start = $(this).find(".break-start").val();
                var end = $(this).find(".break-end").val();
                var reason = $(this).find(".break-reason").val();

                if (start !== "" && end !== "") {

                    breaks.push({
                        StartTime: start,
                        EndTime: end,
                        Reason: reason
                    });

                }

            });


            var days = [];

            $(".day-check:checked").each(function () {

                days.push($(this).val());

            });


            var scheduleData = {

                ScheduleFrom:
                    $("#scheduleFrom").val(),

                ScheduleTo:
                    $("#scheduleTo").val(),

                Days: days,

                StartTime:
                    $("#startTime").val(),

                EndTime:
                    $("#endTime").val(),

                SlotDurationMinutes:
                    $("#slotDuration").val(),

                Breaks: breaks

            };


            $.ajax({

                url: '@Url.Action("SetSchedule", "Doctor")',

                type: 'POST',

                data: scheduleData,

                success: function (response) {

                    if (response.success) {

                        $("#scheduleModal").modal("hide");

                        $("#scheduleForm")[0].reset();

                        $("#breakContainer").empty();

                        alert(response.message);

                    }
                    else {

                        $("#scheduleError")
                            .text(response.message);

                    }

                },

                error: function () {

                    $("#scheduleError")
                        .text("Unable to create schedule.");

                }

            });
        }



        // Clear Schedule Errors
        function clearScheduleErrors() {

            $("#scheduleFromError").text("");

            $("#scheduleToError").text("");

            $("#dayError").text("");

            $("#startTimeError").text("");

            $("#endTimeError").text("");

            $("#slotDurationError").text("");

            $("#scheduleError").text("");

        }

        // Todays Appointments
       function loadDoctorAppointments() {

            $.ajax({
                url: '@Url.Action("GetDoctorAppointments", "Doctor")',
                type: 'GET',

                success: function (response) {

                    console.log("Appointments response:", response);

                    if (response.success === false) {
                        alert(response.message);
                        return;
                    }

                    if ($("#doctorAppointmentGrid")[0].grid) {
                        $("#doctorAppointmentGrid").jqGrid("GridUnload");
                    }

                    $("#doctorAppointmentGrid").jqGrid({
                        datatype: "local",
                        data: response,

                        colModel: [
                            {
                                label: "Appointment ID",
                                name: "AppointmentId",
                                key: true,
                                hidden: true
                            },
                            {
                                label: "Date",
                                name: "ScheduleDate",
                                width: 100,
                                formatter: function (value) {
                                    return value ? value.substring(0, 10) : "";
                                }
                            },
                            {
                                label: "Patient Name",
                                name: "PatientName",
                                width: 150
                            },
                            {
                                label: "Start Time",
                                name: "StartTime",
                                width: 90,
                                formatter: function (value) {
                                    return value ? value.substring(0, 5) : "";
                                }
                            },
                            {
                                label: "End Time",
                                name: "EndTime",
                                width: 90,
                                formatter: function (value) {
                                    return value ? value.substring(0, 5) : "";
                                }
                            },
                            {
                                label: "Phone",
                                name: "Phone",
                                width: 120
                            },
                            {
                                label: "Status",
                                name: "Status",
                                width: 100
                            },
                            {
                                label: "Action",
                                name: "Action",
                                width: 100,
                                sortable: false,
                                formatter: function (cellValue, options, rowObject) {

                                    return '<button type="button" ' +
                                           'class="btn btn-primary btn-xs" ' +
                                           'onclick="manageAppointment(' +
                                           rowObject.AppointmentId +
                                           ')">' +
                                           'Manage</button>';
                                }
                            }
                        ],

                        height: "auto",
                        rowNum: 10,
                        pager: "#doctorAppointmentPager",
                        viewrecords: true,
                        autowidth: true,
                        shrinkToFit: true,
                        caption: "Appointments"
                    });
                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Unable to load appointments.");
                }
            });
}

        function manageAppointment(appointmentId) {

            console.log("Managing AppointmentId:", appointmentId);

            $.ajax({
                url: '@Url.Action("GetMedicalRecord", "Doctor")',
                type: 'GET',
                data: {
                    appointmentId: appointmentId
                },

                success: function (response) {

                    $("#prescriptionContainer").html(response);

                    $("#appointmentModal").modal("show");
                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Unable to load medical record.");
                }
            });
}





    function loadDoctorCalendar() {

            $.ajax({
                url: '@Url.Action("GetDoctorScheduleCalendar", "Doctor")',
                type: 'GET',

                success: function (response) {
                    console.log("Calendar response:", response);
                    var schedules = JSON.parse(response);
                    var events = [];

                    $.each(schedules, function (index, schedule) {

                        events.push({
                            id: schedule.ScheduleId,
                            title: "Scheduled",
                            start: schedule.ScheduleDate,
                            allDay: true,
                            className: "scheduled-date"
                        });

                    });

                    $("#doctorCalendar").fullCalendar({
                        header: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'month'
                        },

                        events: events
                    });
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert("Unable to load doctor schedules.");
                }
            });
        }


        $(document).on("click", "#btnCompleteAppointment", function () {

            var model = {
                AppointmentId: $("#prescriptionAppointmentId").val(),
                Diagnosis: $("#diagnosis").val(),
                DoctorNotes: $("#doctorNotes").val(),
                Medicines: $("#medicines").val(),
                Procedures: $("#procedures").val(),
                Advice: $("#advice").val()
            };

            $.ajax({
                url: '@Url.Action("CompleteAppointment", "Doctor")',
                type: 'POST',
                data: model,

                success: function (response) {

                    if (response.success) {

                        alert(response.message);

                        $("#appointmentModal").modal("hide");

                        loadDoctorAppointments();
                    }
                    else {
                        alert(response.message);
                    }
                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Unable to complete appointment.");
                }
            });
        });

    </script>
}